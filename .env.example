# Required: OpenAI-compatible API key (OpenAI, DeepSeek, OpenRouter, Ollama, ...)
OPENAI_API_KEY=

# Optional: base URL for OpenAI-compatible servers. Default: https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: model id. Default: gpt-4o-mini
AGENT_MODEL=

# Optional: max agent loop steps. Default: 40
AGENT_MAX_STEPS=

# Optional: run code in a Fly Machine sandbox instead of the local shell.
# Both must be set for remote mode; leave blank to use the local sandbox.
SANDBOX_BASE_URL=
SANDBOX_TOKEN=

# ── BuildX environment ────────────────────────────────────────────────────────
# Copy to `.env` (never commit it) and fill in real values. Blank values are
# treated as unset everywhere.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon connection string with SSL required.
# In local development: pooled connection string or direct connection.
# In Cloudflare Workers: pooled Neon WebSocket connection, or Hyperdrive connection string.
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-4.aws.neon.tech/neondb?sslmode=require

# Optional driver override: "neon" (WebSocket/serverless) or "node-pg" (TCP/Hyperdrive/tests).
BUILDX_DB_DRIVER=neon

# Optional Cloudflare Hyperdrive URL if using Hyperdrive connection caching:
# HYPERDRIVE_URL=

# ── Sandbox (Upstash Box - Remote MicroVM) ────────────────────────────────────
# Upstash Box is the SOLE production sandbox for shell commands, file operations,
# builds, and tests. Local sandbox execution is strictly forbidden in production.
UPSTASH_BOX_API_KEY=
BUILDX_SANDBOX_KIND=box

# ── Cloudflare Workers, Queues, KV, and R2 ───────────────────────────────────
# In Cloudflare Workers, these bindings are provided via wrangler.jsonc:
# - BUILDX_QUEUE: Cloudflare Queue for async run dispatch
# - BUILDX_QUEUE_DLQ: Dead-letter queue for failed runs
# - BUILDX_KV: Cloudflare KV for transient, disposable caches (TTLs >= 60s)
# - BUILDX_R2: Cloudflare R2 bucket for artifacts and project archives
# - HYPERDRIVE: Optional Hyperdrive binding for Neon DB connection acceleration
OPENNEXT_CLOUDFLARE=true

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app:
BETTER_AUTH_URL=http://localhost:3000

# ── Cloudflare R2 / S3 Storage (Large objects, snapshots, artifacts) ──────────
# Authoritative state resides in Neon; R2 stores large build artifacts and snapshots.
# S3-compatible credentials for direct S3 client access (if interacting outside Workers):
S3_ENDPOINT=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<custom-r2-domain-or-public-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_WORKSPACES=buildx-artifacts
S3_BUCKET_DB_BACKUPS=buildx-db-backups

# ── Agent (AI Model Harness) ──────────────────────────────────────────────────
# OpenAI-compatible API key (OpenAI, DeepSeek, OpenRouter, etc.):
OPENAI_API_KEY=
# Optional: base URL for OpenAI-compatible servers. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional: model id. Default: gpt-4o
AGENT_MODEL=gpt-4o
# Optional: max agent loop steps. Default: 40
AGENT_MAX_STEPS=40
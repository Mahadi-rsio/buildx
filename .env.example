# ── BuildX environment ────────────────────────────────────────────────────────
# Copy to `.env` (never commit it) and fill in real values. Blank values are
# treated as unset everywhere.

# ── Database (local Postgres via docker compose) ──────────────────────────────
POSTGRES_USER=buildx
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=buildx
DATABASE_URL=postgresql://buildx:change-me-to-a-strong-password@127.0.0.1:5432/buildx

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (local dev):
BETTER_AUTH_URL=http://localhost:3000

# ── MinIO (local S3-compatible object storage via docker compose) ─────────────
# Upstream `minio/minio` was archived in 2026; default is the community fork
# `pgsty/minio`, pinned to a release tag (never `latest`). Swappable — point
# MINIO_IMAGE at any S3-compatible server, or switch S3_ENDPOINT to R2 etc.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# Strong random values, never the minioadmin defaults:
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── S3 storage module ─────────────────────────────────────────────────────────
# Server-side (internal) endpoint and credentials. In dev these may be the MinIO
# root credentials; PRODUCTION MUST use a dedicated service account restricted to
# the two buckets below — never root. Public MinIO console/ports never exposed.
S3_ENDPOINT=http://127.0.0.1:9000
# Endpoint handed to sandboxes (Fly Machines) for presigned URLs. Must be
# reachable from the internet: a tunnel in dev, a TLS reverse proxy in prod.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_WORKSPACES=buildx-workspaces
S3_BUCKET_DB_BACKUPS=buildx-db-backups

# ── Agent (unchanged) ─────────────────────────────────────────────────────────
# OpenAI-compatible API key (OpenAI, DeepSeek, OpenRouter, Ollama, ...):
OPENAI_API_KEY=
# Optional: base URL for OpenAI-compatible servers. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional: model id. Default: gpt-4o-mini
AGENT_MODEL=
# Optional: max agent loop steps. Default: 40
AGENT_MAX_STEPS=

# ── Sandbox (local dev vs Fly Machines) ───────────────────────────────────────
# Remote mode requires both; leave blank for the local sandbox.
SANDBOX_BASE_URL=
SANDBOX_TOKEN=

# ── Fly Machines (provisioning only; kept in the web backend, never in a box) ─
FLY_API_TOKEN=
FLY_ORG_SLUG=
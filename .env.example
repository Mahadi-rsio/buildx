# ── BuildX environment ────────────────────────────────────────────────────────
# Copy to `.env` (never commit it) and fill in real values. Blank values are
# treated as unset everywhere.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon connection string with SSL required.
# In local development and Node.js production: pooled connection string or direct connection.
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-4.aws.neon.tech/neondb?sslmode=require

# Optional driver override: "node-pg" (TCP pool / Node.js) or "neon" (WebSocket serverless).
# Defaults to "node-pg" when pg is available.
BUILDX_DB_DRIVER=node-pg

# ── Sandbox (Upstash Box - Remote MicroVM) ────────────────────────────────────
# Upstash Box is the SOLE production sandbox for shell commands, file operations,
# builds, and tests. Local sandbox execution is strictly forbidden in production.
UPSTASH_BOX_API_KEY=
BUILDX_SANDBOX_KIND=box

# ── Background Worker ─────────────────────────────────────────────────────────
# By default, runs are executed by an in-process Node.js worker with database leases.
# Set BUILDX_DISABLE_LOCAL_WORKER=true only if running a dedicated worker process.
# BUILDX_DISABLE_LOCAL_WORKER=false

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app:
BETTER_AUTH_URL=http://localhost:3000

# ── Storage (S3 / Cloudflare R2 - Large objects, snapshots, artifacts) ────────
# Authoritative state resides in Neon; S3/R2 stores large build artifacts and snapshots.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<custom-domain-or-public-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_WORKSPACES=buildx-artifacts
S3_BUCKET_DB_BACKUPS=buildx-db-backups

# ── Agent (AI Model Harness) ──────────────────────────────────────────────────
# OpenAI-compatible API key (OpenAI, DeepSeek, OpenRouter, etc.):
OPENAI_API_KEY=
# Optional: base URL for OpenAI-compatible servers. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional: model id. Default: gpt-4o
AGENT_MODEL=gpt-4o
# Optional: max agent loop steps. Default: 40
AGENT_MAX_STEPS=40

# ── Second provider: Vercel AI Gateway (paid models) ──────────────────────────
# When set, the model picker also lists paid models from the Vercel AI Gateway
# and runs that select one of them route through this gateway instead of the
# primary provider. Ids use the gateway's `provider/model` format (e.g.
# `openai/gpt-4o`, `anthropic/claude-3-5-sonnet-20241022`).
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# ── Third provider: LiteLLM Proxy (production multi-provider routing) ─────────
# When set, the model picker lists the LiteLLM aliases first and aliased /
# `litellm/`-prefixed model ids route through the proxy.
# LITELLM_API_KEY is an app-scoped virtual key, NOT the master/admin key.
LITELLM_API_KEY=
# Default for the bundled docker-compose service: http://localhost:4000/v1
LITELLM_BASE_URL=http://localhost:4000/v1

# LiteLLM proxy config (server-side only; consumed by the `litellm` container).
# Admin key for the proxy (generate with: openssl rand -base64 32).
LITELLM_MASTER_KEY=
# Upstream provider credentials used by ./litellm/config.yaml aliases:
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_PAID_API_KEY=
OPENROUTER_PAID_MODEL=anthropic/claude-3.7-sonnet
VERCEL_MODEL=openai/gpt-4o-mini
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_GATEWAY_BASE_URL=
CLOUDFLARE_AI_GATEWAY_API_KEY=

# ── Quota (Upstash Redis - authoritative daily request budget) ────────────────
# Hard limit: 50 upstream model requests per user per Asia/Dhaka day.
# Server-only. Never expose these to the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
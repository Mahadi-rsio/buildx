# ── BuildX environment ────────────────────────────────────────────────────────
# Copy to `.env` (never commit it) and fill in real values. Blank values are
# treated as unset everywhere.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon connection string with SSL required.
# In local development and Node.js production: pooled connection string or direct connection.
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-4.aws.neon.tech/neondb?sslmode=require

# Optional driver override: "node-pg" (TCP pool / Node.js) or "neon" (WebSocket serverless).
# Defaults to "node-pg" when pg is available.
BUILDX_DB_DRIVER=node-pg

# ── Sandbox (Upstash Box - Remote MicroVM) ────────────────────────────────────
# Upstash Box is the only sandbox for shell commands, file operations, builds,
# and tests. There is no host-local execution fallback.
UPSTASH_BOX_API_KEY=

# ── Background Worker ─────────────────────────────────────────────────────────
# By default, runs are executed by an in-process Node.js worker with database leases.
# Set BUILDX_DISABLE_LOCAL_WORKER=true only if running a dedicated worker process.
# BUILDX_DISABLE_LOCAL_WORKER=false

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app:
BETTER_AUTH_URL=http://localhost:3000

# ── MCP (Streamable HTTP servers configured in Settings) ──────────────────────
# Encrypts per-user MCP auth headers at rest. Defaults to BETTER_AUTH_SECRET.
# Generate with: openssl rand -base64 32
MCP_ENCRYPTION_KEY=
# Opt-in escape hatch for self-hosted MCP servers on localhost/private IPs.
# Never enable this on a public deployment: it disables the SSRF guard.
MCP_ALLOW_PRIVATE_HOSTS=false

# ── GitHub App (publish branches + pull requests) ────────────────────────────
# Create a GitHub App with:
#   - Callback URL: ${BETTER_AUTH_URL}/api/github/callback
#   - Setup URL:    ${BETTER_AUTH_URL}/api/github/callback
#     (GitHub redirects here after the App is installed; the callback verifies
#      the installation server-side and returns the user to their project.)
#   - Webhook URL:  ${BETTER_AUTH_URL}/api/github/webhook
#   - Repository permissions: Contents (read/write), Pull requests (read/write),
#     Metadata (read); add Administration (read/write) if createRepository is used.
#   - User permissions: none required
# Access is installation-based: the App ID + private key mint short-lived
# installation tokens on demand. No user access token is exchanged or stored.
GITHUB_APP_ID=
# GitHub App slug (used to build the "install on GitHub" URL).
GITHUB_APP_SLUG=
# PEM from the App settings, either literal newlines or escaped \n; base64 is OK.
GITHUB_APP_PRIVATE_KEY=
# Secret configured on the App's webhook, verified via X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
# Signs the connect/return-to state during App installation. Defaults to
# BETTER_AUTH_SECRET. Generate with: openssl rand -base64 32
GITHUB_ENCRYPTION_KEY=
# GitHub Enterprise only; defaults to https://api.github.com.
GITHUB_API_URL=

# ── Storage (S3 / Cloudflare R2 - Large objects, snapshots, artifacts) ────────
# Authoritative state resides in Neon; S3/R2 stores large build artifacts and snapshots.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<custom-domain-or-public-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_WORKSPACES=buildx-artifacts
S3_BUCKET_DB_BACKUPS=buildx-db-backups

# ── Agent (AI Model Harness) ──────────────────────────────────────────────────
# Optional: model id. LiteLLM exposes only `auto`. Default: auto
AGENT_MODEL=auto
# Optional: max agent loop steps. Default: 40
AGENT_MAX_STEPS=40

# ── Primary provider: LiteLLM Proxy (multi-provider routing) ──────────────────
# The model picker lists `auto`, which the proxy load-balances across the
# configured upstreams.
# LITELLM_API_KEY is an app-scoped virtual key, NOT the master/admin key.
LITELLM_API_KEY=
# Default for the bundled docker-compose service: http://localhost:4000/v1
LITELLM_BASE_URL=http://localhost:4000/v1

# LiteLLM proxy config (server-side only; consumed by the `litellm` container).
# Admin key for the proxy (must start with `sk-`). Used only to mint virtual keys.
LITELLM_MASTER_KEY=
# Encrypts provider keys stored in the proxy database. Required for virtual keys.
LITELLM_SALT_KEY=
# Local compose creates a dedicated database for LiteLLM keys/spend logs.
LITELLM_DB_NAME=litellm
# Upstream provider credentials used by ./litellm/config.yaml `auto` group.
# Alias -> upstream model ids live in ./litellm/config.yaml, not in env.
# All deployments are free tiers; missing keys only disable that fallback.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Cloudflare Workers AI (account id + API token with Workers AI permission).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
# Google Gemini API key (generativelanguage.googleapis.com).
GEMINI_API_KEY=
# Mistral La Plateforme key (free tier exposes Codestral/Ministral).
MISTRAL_API_KEY=
# Vercel AI Gateway (also used by the app's direct Vercel provider).
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# ── Optional provider: OpenRouter (full model catalog) ───────────────────────
# When set, the model picker lists the full OpenRouter catalog and runs that
# select one of those ids route directly through OpenRouter. Ids use the
# `provider/model` format (e.g. `openai/gpt-4o`). Reuses OPENROUTER_API_KEY.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Quota (Upstash Redis - authoritative daily request budget) ────────────────
# Hard limit: 50 upstream model requests per user per Asia/Dhaka day.
# Server-only. Never expose these to the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=